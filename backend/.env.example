# ClassTikTok — copy file này thành `.env` trong thư mục backend/
# (file `.env` đã có trong .gitignore, KHÔNG commit key thật lên GitHub)
#
# Database SQLite (bắt buộc — không có dòng này thì `npx prisma db push` lỗi P1012)
DATABASE_URL="file:./dev.db"
#
# Lấy key miễn phí tại: https://aistudio.google.com/apikey
# Dán key vào đây, KHÔNG gửi key qua chat.
GEMINI_API_KEY=

# Model Gemini dùng để chấm đáp án (mặc định: gemini-2.0-flash, nhanh + rẻ)
GEMINI_MODEL=gemini-2.0-flash

# AI chờ tối đa bao nhiêu ms cho 1 comment (quá thì giữ kết quả luật)
GEMINI_TIMEOUT_MS=8000

# Gemini phải tự tin từ mức này (0-1) mới được sửa kết quả của luật
AI_MIN_CONFIDENCE=0.8

# Số call Gemini chạy cùng lúc tối đa (live đông cũng không bắn ồ ạt)
AI_MAX_CONCURRENT=5

#
# EULER_API_KEY (không bắt buộc — chỉ cần khi máy chủ ký miễn phí bị giới hạn)
# Tạo key miễn phí tại: https://www.eulerstream.com
# Dán key vào đây, KHÔNG gửi key qua chat.
EULER_API_KEY=
